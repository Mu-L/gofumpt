# TODO: joining the lines of an assignment whose token is followed by a comment
# leaves the right-hand side at an indentation that gofmt would not produce, so
# the "// inline" and "/* multi" cases in the golden file below are not
# gofmt-clean. The comment should hold the two lines apart instead.
exec gofumpt -w foo.go
cmp foo.go foo.go.golden

exec gofumpt -d foo.go.golden
! stdout .

-- foo.go --
package p

func f() {
    foo :=


        "bar"

    foo :=
        "bar"

	_, _ =
		0,
		1

	_, _ = 0,
		1

    _ =
        `
            foo
        `

	_ = /* inline */
		"foo"

	_ = // inline
		"foo"

	_ = /* multi
		line */
		"foo"

	long :=
		"foo " +
			"bar " +
			"baz"
	_ = long

	a, b, c :=
		"foo",
		"bar",
		"qux"
	_, _, _ = a, b, c
}

-- foo.go.golden --
package p

func f() {
	foo := "bar"

	foo := "bar"

	_, _ =
		0,
		1

	_, _ = 0,
		1

	_ = `
            foo
        `

	_ = /* inline */ "foo"

	_ = // inline
	"foo"

	_ = /* multi
	line */ "foo"

	long :=
		"foo " +
			"bar " +
			"baz"
	_ = long

	a, b, c :=
		"foo",
		"bar",
		"qux"
	_, _, _ = a, b, c
}
